rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // La credencial compartida del panel de rescate inicia sesión con
    // email/password; los teléfonos de la app usan Firebase Anonymous Auth
    // (ver docs/adr/0003-identidad-participantes-registro-opt-in.md).
    function isRescuePanel() {
      return isAuthenticated() &&
        request.auth.token.firebase.sign_in_provider == 'password';
    }

    // El ID de documento no es arbitrario: codifica la convención de
    // deduplicación (docs/adr/0002-dedup-multi-gateway-id-deterministico.md)
    // para que dos gateways subiendo el mismo (persona, secuencia) escriban
    // siempre el mismo documento, sin depender de que el cliente la respete.
    function matchesMeshStateId(docId, data) {
      return docId == data.device_id_hash + '_' + string(data.sequence);
    }

    function matchesParticipantId(docId, data) {
      return docId == data.device_id_hash;
    }

    // Campos que esta escritura agrega/cambia respecto al documento previo
    // — `resource` es `null` en un `create` (no hay documento previo), así
    // que se compara contra un mapa vacío en ese caso (todos los campos
    // entrantes cuentan como "afectados").
    function affectedParticipantKeys() {
      return request.resource.data.diff(resource != null ? resource.data : {}).affectedKeys();
    }

    // Registro opt-in de la propia identidad (ADR-0003, #29/#30):
    // `device_id_hash` + `name` + `contacto` opcional. `public_key_ed25519`
    // (#46/#47) viaja en el mismo registro — es un dato del dispositivo, no
    // ingresado por la persona, pero se sube junto al resto del perfil.
    function isSelfRegistrationWrite() {
      return affectedParticipantKeys().hasOnly(['device_id_hash', 'public_key_ed25519', 'name', 'contacto']);
    }

    // Confirmación de identidad Caso A subida por un gateway ajeno (#44/#45,
    // #52/#53) — nunca puede tocar `name`/`contacto` de un documento que no
    // es el propio, a diferencia del registro opt-in de arriba.
    function isIdentityConfirmationWrite() {
      return affectedParticipantKeys().hasOnly(['device_id_hash', 'identidad_verificada_caso_a']);
    }

    match /mesh_states/{docId} {
      allow read: if isRescuePanel();
      allow create, update: if isAuthenticated() &&
        matchesMeshStateId(docId, request.resource.data);
    }

    match /participants/{docId} {
      allow read: if isRescuePanel();
      allow create, update: if isAuthenticated() &&
        matchesParticipantId(docId, request.resource.data) &&
        (isSelfRegistrationWrite() || isIdentityConfirmationWrite());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
